{
  // Renovate global config used by the renovate-global workflow for all repos
  // https://docs.renovatebot.com/configuration-options/
  $schema: "https://docs.renovatebot.com/renovate-global-schema.json",

  // # keep-sorted start block=yes
  "git-submodules": {
    enabled: true,
  },
  // Update hook revisions in .pre-commit-config.yaml (disabled by default)
  // https://docs.renovatebot.com/modules/manager/pre-commit/
  "pre-commit": {
    enabled: true,
  },
  // Automatically discover all repositories accessible by the token
  // https://docs.renovatebot.com/self-hosted-configuration/#autodiscover
  autodiscover: true,
  // Filter autodiscovery to only ruzickap repositories, with a few explicit exclusions
  // https://docs.renovatebot.com/self-hosted-configuration/#autodiscoverfilter
  autodiscoverFilter: [
    "!ruzickap/k8s-multicluster-gitops",
    "!ruzickap/old_stuff",
    "!ruzickap/ruzickovabozena.xvx.cz",
    "ruzickap/*",
  ],
  // Automatically merge PRs when all tests pass
  // https://docs.renovatebot.com/configuration-options/#automerge
  automerge: true,
  // Merge directly to the base branch without creating a PR
  // https://docs.renovatebot.com/configuration-options/#automergetype
  automergeType: "branch",
  // Custom prefix for Renovate branches
  // https://docs.renovatebot.com/configuration-options/#branchprefix
  branchPrefix: "chore/renovate/",
  // This allows Renovate to detect and update dependencies that aren't in standard package files
  customManagers: [
    {
      customType: "regex",
      // Template for extracting version numbers from custom patterns
      extractVersionTemplate: "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}",

      // File types to scan for custom dependency patterns
      managerFilePatterns: [
        "/\\.ya?ml$/",
        "/\\.md$/",
        "/^Dockerfile$/",
        "/^entrypoint\\.sh$/",
      ],

      // Format: # renovate: datasource=<source> depName=<name> [versioning=<type>] [extractVersion=<regex>] [registryUrl=<url>]
      // Optional "@sha256:<64 hex>" suffix is captured as currentDigest (digest update, not a failing pinDigest)
      matchStrings: [
        '# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?( extractVersion=(?<extractVersion>.+?))?( registryUrl=(?<registryUrl>.+?))?\\s[^@\\n]*[=:]\\s*"?(?<currentValue>.+?)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?"?\\s',
      ],

      // Default to semantic versioning unless specified otherwise
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  // Base Configuration Presets
  // Keep the extends started with ":" at the end of the list to allow overriding
  extends: [
    "config:recommended", // Renovate's recommended configuration preset
    "docker:pinDigests", // Pin Docker image digests for security
    "helpers:pinGitHubActionDigestsToSemver", // Pin GitHub Actions to specific versions with semantic versioning
    "security:openssf-scorecard", // Add OpenSSF Scorecard security insights
    ":disableDependencyDashboard", // Don't create dependency dashboard issues
    ":disableRateLimiting", // Disable rate limiting for faster updates
    ":enableVulnerabilityAlertsWithLabel(security)", // Add security label to vulnerability alerts
    ":pinSkipCi", // Pin dependencies and skip CI for pin-only updates
  ],
  // Check minimumReleaseAge internally instead of POSTing a "renovate/stability-days"
  // status, whose 422 aborts every repo before automerge (needs timestamp-optional)
  internalChecksFilter: "strict",
  // Scan Kubernetes manifests in deploy directory (for malware-cryptominer-container)
  kubernetes: {
    managerFilePatterns: ["/^deploy/.+\\.ya?ml$/"],
  },
  // Pull Request Labeling
  labels: [
    "renovate",
    "renovate/{{replace '.*/' '' depName}}",
    "renovate/{{updateType}}",
  ],
  // Lock File Maintenance
  lockFileMaintenance: {
    enabled: true,
  },
  // Wait for releases to be at least 3 days old before creating PRs (reduces risk of buggy releases)
  minimumReleaseAge: "3 days",
  // Don't hold back updates without release timestamps (e.g. ghcr.io/quay.io tags) forever
  // under "strict"; trade-off: they skip the minimumReleaseAge cooldown
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Disable onboarding PRs since we manage config centrally in this repo
  // https://docs.renovatebot.com/self-hosted-configuration/#onboarding
  onboarding: false,
  // Package-specific Update Rules
  packageRules: [
    {
      description: "Disable auto-merge for major updates",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // No release timestamps here; skip to silence the warning. ghcr.io/quay.io
      // still warn: matching "docker" would drop the Docker Hub cooldown too.
      description: "Skip minimumReleaseAge for git-based datasources without timestamps",
      matchDatasources: ["git-refs", "git-tags", "github-digest"],
      minimumReleaseAge: null,
    },
    {
      // Drop the image tag from the digest commit subject so it fits commit-check's
      // 72-char limit (which blocks automerge); the PR body still shows the tag
      description: "Shorten Docker digest commit subject to fit 72-char limit",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      commitMessageTopic: "{{{depName}}} digest",
    },
    {
      description: "Group all GitHub Actions updates into a single PR",
      groupName: "github actions",
      matchManagers: ["github-actions"],
    },
    {
      description: "Group all mise updates into a single PR",
      groupName: "mise",
      matchManagers: ["mise"],
    },
    {
      // Limit regular updates to GitHub Actions; security fixes bypass this rule
      // and are blocked via vulnerabilityAlerts.force.packageRules below
      description: "Only update GitHub Actions in brewwatch repo",
      matchRepositories: ["ruzickap/brewwatch"],
      matchManagers: ["!github-actions"],
      enabled: false,
    },
    {
      description: "Skip pinning for slsa-framework/slsa-github-generator",
      matchRepositories: ["ruzickap/malware-cryptominer-container"],
      matchPackageNames: ["slsa-framework/slsa-github-generator"],
      pinDigests: false,
    },
    {
      // The custom regex manager can't write a digest into values without one,
      // so docker:pinDigests fails with "update failure"; only bump versions
      description: "Custom regex manager can't pin Docker digests; only bump versions",
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    {
      // The ansible manager treats docker_container "comparisons: { image: strict }"
      // as an image and probes docker.io/library/strict (harmless 401)
      description: "Ignore ansible docker_container comparisons:image:strict false positive",
      matchRepositories: ["ruzickap/ansible-raspberry-pi-os"],
      matchManagers: ["ansible"],
      matchDatasources: ["docker"],
      matchPackageNames: ["strict", "library/strict"],
      enabled: false,
    },
    {
      description: "Skip renovating _posts directory in ruzickap.github.io",
      matchRepositories: ["ruzickap/ruzickap.github.io"],
      matchFileNames: ["_posts/**"],
      enabled: false,
    },
    {
      description: "Pin Ruby to 3.x in ruzickap.github.io (skip major v4)",
      matchRepositories: ["ruzickap/ruzickap.github.io"],
      matchPackageNames: ["ruby"],
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    // ========== release-please: map dependency bumps to fix/feat/feat! commits ==========
    // Use commitMessagePrefix: preset "chore" rules are appended later and override semanticCommitType
    {
      // Open a PR assigned to ruzickap (not a silent branch merge) to notice the bump;
      // patch/minor automerge, major stays manual via the "Disable auto-merge" rule
      description: "Assign release-triggering MegaLinter bumps to ruzickap",
      matchRepositories: ["ruzickap/megalinter-custom-flavor-my-repos"],
      matchDepNames: ["oxsecurity/megalinter"],
      assignAutomerge: true,
      assignees: ["ruzickap"],
      automergeType: "pr",
      commitMessageAction: "update",
      commitMessageTopic: "MegaLinter",
    },
    {
      description: "MegaLinter patch bump must be fix so release-please cuts a patch release",
      matchRepositories: ["ruzickap/megalinter-custom-flavor-my-repos"],
      matchDepNames: ["oxsecurity/megalinter"],
      matchUpdateTypes: ["patch"],
      commitMessagePrefix: "fix(deps):",
    },
    {
      description: "MegaLinter minor bump must be feat so release-please cuts a minor release",
      matchRepositories: ["ruzickap/megalinter-custom-flavor-my-repos"],
      matchDepNames: ["oxsecurity/megalinter"],
      matchUpdateTypes: ["minor"],
      commitMessagePrefix: "feat(deps):",
    },
    {
      description: "MegaLinter major bump must be feat! so release-please cuts a major release",
      matchRepositories: ["ruzickap/megalinter-custom-flavor-my-repos"],
      matchDepNames: ["oxsecurity/megalinter"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(deps)!:",
    },
    {
      // markdownlint-cli provides the action's user-facing linting behavior,
      // so its bumps must trigger a release-please minor release.
      description: "markdownlint-cli bump must be feat so release-please releases it",
      matchRepositories: ["ruzickap/action-my-markdown-linter"],
      matchPackageNames: ["markdownlint-cli"],
      assignAutomerge: true,
      assignees: ["ruzickap"],
      automergeType: "pr",
      commitMessageAction: "update",
      commitMessagePrefix: "feat(deps):",
    },
    {
      description: "Assign release-triggering markdown-link-check bumps to ruzickap",
      matchRepositories: ["ruzickap/action-my-markdown-link-checker"],
      matchPackageNames: ["markdown-link-check"],
      assignAutomerge: true,
      assignees: ["ruzickap"],
      automergeType: "pr",
      commitMessageAction: "update",
    },
    {
      description: "markdown-link-check patch bump must be fix so release-please cuts a patch release",
      matchRepositories: ["ruzickap/action-my-markdown-link-checker"],
      matchPackageNames: ["markdown-link-check"],
      matchUpdateTypes: ["patch"],
      commitMessagePrefix: "fix(deps):",
    },
    {
      description: "markdown-link-check minor bump must be feat so release-please cuts a minor release",
      matchRepositories: ["ruzickap/action-my-markdown-link-checker"],
      matchPackageNames: ["markdown-link-check"],
      matchUpdateTypes: ["minor"],
      commitMessagePrefix: "feat(deps):",
    },
    {
      description: "markdown-link-check major bump must be feat! so release-please cuts a major release",
      matchRepositories: ["ruzickap/action-my-markdown-link-checker"],
      matchPackageNames: ["markdown-link-check"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(deps)!:",
    },
    {
      description: "Assign release-triggering Muffet bumps to ruzickap",
      matchRepositories: ["ruzickap/action-my-broken-link-checker"],
      matchPackageNames: ["raviqqe/muffet"],
      assignAutomerge: true,
      assignees: ["ruzickap"],
      automergeType: "pr",
      commitMessageAction: "update",
    },
    {
      description: "Muffet patch bump must be fix so release-please cuts a patch release",
      matchRepositories: ["ruzickap/action-my-broken-link-checker"],
      matchPackageNames: ["raviqqe/muffet"],
      matchUpdateTypes: ["patch"],
      commitMessagePrefix: "fix(deps):",
    },
    {
      description: "Muffet minor bump must be feat so release-please cuts a minor release",
      matchRepositories: ["ruzickap/action-my-broken-link-checker"],
      matchPackageNames: ["raviqqe/muffet"],
      matchUpdateTypes: ["minor"],
      commitMessagePrefix: "feat(deps):",
    },
    {
      description: "Muffet major bump must be feat! so release-please cuts a major release",
      matchRepositories: ["ruzickap/action-my-broken-link-checker"],
      matchPackageNames: ["raviqqe/muffet"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(deps)!:",
    },
  ],
  // PR body template showing dependency table, notes, and changelogs
  // https://docs.renovatebot.com/configuration-options/#prbodytemplate
  prBodyTemplate: "{{{table}}}{{{notes}}}{{{changelogs}}}",
  // Rebase branches when they fall behind the base branch
  // https://docs.renovatebot.com/configuration-options/#rebasewhen
  rebaseWhen: "behind-base-branch",
  // Process repositories even without a local Renovate config file
  // https://docs.renovatebot.com/self-hosted-configuration/#requireconfig
  requireConfig: "optional",
  // Force Conventional Commits messages and PR titles; the default "auto" mode
  // can flip to "disabled" and produce titles like "Update dependency ..."
  semanticCommits: "enabled",
  // Create separate branches for minor and patch updates
  // https://docs.renovatebot.com/configuration-options/#separateminorpatch
  separateMinorPatch: true,
  // Skip the "renovate/stability-days" status POST, whose 422 aborts the repo before
  // automerge; minimumReleaseAge is still enforced internally
  statusCheckNames: {
    minimumReleaseAge: null,
  },
  // Security (vulnerability) updates
  // https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts
  vulnerabilityAlerts: {
    // Security fixes ignore normal packageRules, so block non-github-actions
    // security updates for brewwatch here via force.packageRules
    force: {
      packageRules: [
        {
          description: "Only update GitHub Actions in brewwatch repo (security)",
          matchRepositories: ["ruzickap/brewwatch"],
          matchManagers: ["!github-actions"],
          enabled: false,
        },
      ],
    },
    // Bump vulnerable deps to the newest version, not the advisory's minimum fix
    // (the default "lowest" rewrites ranges downward, e.g. "^8.5.15" -> "^8.5.6")
    vulnerabilityFixStrategy: "highest",
  },
  // # keep-sorted end
}
